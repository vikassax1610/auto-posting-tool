PORT=5000
MONGO_URI=mongodb://localhost:27017/social-media-publisher
JWT_SECRET=your_jwt_secret_here

# Platform API Keys
# Facebook publishing requires a User token authorized with pages_show_list,
# pages_read_engagement, and pages_manage_posts. A Page token is derived when
# the Page is connected. A matching Page token may also be supplied directly.
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# A public image host is required for Instagram publishing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
